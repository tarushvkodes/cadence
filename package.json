{
  "name": "cadence",
  "private": true,
  "version": "1.0.0",
  "description": "Your week, in step with your cycle. A local cycle-aware planner with a Claude agent that proposes, never imposes.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,bridge --prefix-colors magenta,cyan \"vite\" \"tsx watch --clear-screen=false bridge/server.ts\"",
    "dev:web": "vite",
    "bridge": "tsx bridge/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "contrast": "tsx scripts/contrast.ts",
    "record": "tsx scripts/record-flows.ts",
    "screens": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.323",
    "lucide-react": "1.72.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
